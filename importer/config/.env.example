# 路徑相對 importer 根目錄
GOOGLE_APPLICATION_CREDENTIALS=config/gcp-adc.json
GOOGLE_DRIVE_SOURCE_CONFIG=config/google_drive_sources.yaml
GOOGLE_DWD_SUBJECT_EMAIL=

# DashScope embedding
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_MODEL=qwen3-vl-embedding
DASHSCOPE_VECTOR_SIZE=2560
# Qwen API 圖片硬限制為 10240 KB；實測以 base64 解碼後的圖片 bytes 計，不以 base64 字串或整個 request payload 計
DASHSCOPE_IMAGE_MAX_BYTES=9728000
# 圖片超過上限時，轉 JPEG 的起始品質（1-100）
DASHSCOPE_JPEG_QUALITY=95

# Qdrant write target
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=
QDRANT_VECTOR_SIZE=2560

# Document conversion
KBSEARCH_CJK_FONT_PATH=C:\Windows\Fonts\msjh.ttc
# 一般 PDF 頁面的目標渲染解析度（72-600 DPI）
IMPORTER_PDF_RENDER_TARGET_DPI=200
# 單頁渲染像素上限（1-89000000），避免 Pillow 記憶體與安全限制
IMPORTER_PDF_RENDER_MAX_PIXELS=80000000

# Work file retention
IMPORTER_KEEP_SUCCESS_WORK_FILES=true
IMPORTER_KEEP_FAILED_WORK_FILES=true

# Run log retention (days); set 0 to disable cleanup
IMPORTER_LOG_RETENTION_DAYS=14
