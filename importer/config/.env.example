# Google Workspace source
GOOGLE_DRIVE_SOURCE_CONFIG=./config/google_drive_sources.yaml
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_DWD_SUBJECT_EMAIL=

# DashScope embedding
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_MODEL=qwen3-vl-embedding
DASHSCOPE_VECTOR_SIZE=2560

# Qdrant write target
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=
QDRANT_VECTOR_SIZE=2560

# Document conversion
LIBREOFFICE_COMMAND=C:\Program Files\LibreOffice\program\soffice.exe
# Optional CJK font file for TXT/MD to PDF conversion in containers.
# Example: /usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
KBSEARCH_CJK_FONT_PATH=

# Work file retention
IMPORTER_KEEP_SUCCESS_WORK_FILES=true
IMPORTER_KEEP_FAILED_WORK_FILES=true
