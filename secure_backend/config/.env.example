# KBSearch Secure Backend example configuration.
# Copy this file to secure_backend/config/.env and fill in deployment values.

# DashScope multimodal embedding settings.
DASHSCOPE_API_KEY=replace-with-dashscope-api-key
DASHSCOPE_EMBEDDING_MODEL=replace-with-embedding-model
DASHSCOPE_VECTOR_SIZE=1024

# Qdrant vector store settings.
QDRANT_URL=https://qdrant.example.com
QDRANT_API_KEY=replace-with-qdrant-api-key
QDRANT_COLLECTION=kbsearch
QDRANT_VECTOR_SIZE=1024

# Required application log file. Relative paths are resolved from the secure_backend app root. Rotates daily.
KBSEARCH_SECURE_BACKEND_LOG_FILE=logs/secure_backend.log
