# KBSearch Query CLI example configuration.
# Copy this file to query_cli/config/.env and fill in local values.

# URL of the secure_backend FastAPI service.
KBSEARCH_SECURE_BACKEND_BASE_URL=http://127.0.0.1:8000
KBSEARCH_SECURE_BACKEND_API_KEY=replace-with-secure-backend-api-key

# Google OAuth client JSON path (relative to query_cli root).
GOOGLE_OAUTH_CLIENT_CONFIG=config/oauth_client.json

# Query log directory. Relative paths resolve from the current working directory.
KBSEARCH_QUERY_LOGS_ROOT=logs

# Tasks directory used by the query result viewer. Relative paths resolve from the current working directory.
KBSEARCH_TASKS_ROOT=tasks

# Query result viewer port.
KBSEARCH_VIEWER_PORT=8501

# Per-run query log retention (days); set 0 to disable cleanup.
KBSEARCH_QUERY_LOG_RETENTION_DAYS=14

# Per-run query log level: DEBUG, INFO, WARNING or ERROR.
KBSEARCH_LOG_LEVEL=INFO

# Required: absolute path to the CJK font used for TXT/MD PDF conversion.
KBSEARCH_CJK_FONT_PATH=C:\Windows\Fonts\msjh.ttc
