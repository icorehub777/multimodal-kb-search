# KBSearch Query CLI example configuration.
# Copy this file to query_cli/config/.env and fill in local values.

# URL of the secure_backend FastAPI service.
KBSEARCH_SECURE_BACKEND_BASE_URL=http://127.0.0.1:8000

# Google OAuth client JSON used for user authorization-code flow.
# Keep the actual client secret file outside Git.
GOOGLE_OAUTH_CLIENT_CONFIG=C:/Users/your-user/.kbsearch/oauth_client.json

# User OAuth token cache. Keep this outside the repository.
GOOGLE_OAUTH_TOKEN_CACHE=C:/Users/your-user/.kbsearch/token.json

# Optional: query output root. Relative paths are resolved from the current working directory.
# In deployed agent_runtime/query_cli, use ../query_results.
# In this repository's query_cli directory, use ../agent_runtime/query_results.
KBSEARCH_QUERY_RESULTS_ROOT=../agent_runtime/query_results

# Optional: query CLI log directory. Relative paths are resolved from the current working directory.
# The CLI writes kbsearch_cli.log and rotates it daily at midnight.
KBSEARCH_QUERY_LOGS_ROOT=logs

# Absolute path to LibreOffice for DOC/DOCX/PPT/PPTX conversion.
LIBREOFFICE_COMMAND=C:/Program Files/LibreOffice/program/soffice.exe

# Required: absolute path to the CJK font used for TXT/MD PDF conversion.
KBSEARCH_CJK_FONT_PATH=C:/Windows/Fonts/msjh.ttc
