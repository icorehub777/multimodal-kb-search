# KBSearch Query CLI example configuration.
# Copy this file to query_cli/config/.env and fill in local values.

# URL of the secure_backend FastAPI service.
KBSEARCH_SECURE_BACKEND_BASE_URL=http://127.0.0.1:8000

# Google OAuth client JSON and user token cache (relative to query_cli root).
GOOGLE_OAUTH_CLIENT_CONFIG=config/oauth_client.json
GOOGLE_OAUTH_TOKEN_CACHE=config/token_cache.json

# Query output and log directories. Relative paths resolve from the current working directory.
KBSEARCH_QUERY_RESULTS_ROOT=query_results
KBSEARCH_QUERY_LOGS_ROOT=logs

# Absolute path to LibreOffice for DOC/DOCX/PPT/PPTX conversion.
LIBREOFFICE_COMMAND=C:\Program Files\LibreOffice\program\soffice.exe

# Required: absolute path to the CJK font used for TXT/MD PDF conversion.
KBSEARCH_CJK_FONT_PATH=C:\Windows\Fonts\msjh.ttc
