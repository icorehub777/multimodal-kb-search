# 複製為 .env 後填入實際值（.env 勿提交至版控）

# 服務帳戶 Email（GCP IAM）
GOOGLE_SERVICE_ACCOUNT_EMAIL=kbsearch-indexer@kbsearch-agent.iam.gserviceaccount.com

# Domain-Wide Delegation 要模擬的 Workspace 使用者（須為公司內真實帳號）
GOOGLE_DWD_SUBJECT_EMAIL=your-colleague@yourcompany.com

# 選填：OAuth scope，預設為 Drive 唯讀
# GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive.readonly
