# 複製為 .env 後填入實際值（.env 勿提交至版控）

# Qdrant Cloud 叢集 URL（Dashboard → Cluster → URL）
QDRANT_URL=https://b021a478-36b4-4dd3-812b-d189971a03b3.australia-southeast1-0.gcp.cloud.qdrant.io

# Qdrant Cloud API Key（Dashboard → API Keys）
QDRANT_API_KEY=

# 與 Cloud 上既有 collection 同名
QDRANT_COLLECTION=kbsearch_integration_test

# 須與 collection 一致：2560 維、Cosine（對應阿里雲多模態 Embedding）
QDRANT_VECTOR_SIZE=2560

# 設為 1 時略過所有 Qdrant 串接測試
# QDRANT_SKIP=1
