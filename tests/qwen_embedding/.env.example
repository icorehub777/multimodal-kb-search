# 複製為 .env 後填入實際值（.env 勿提交至版控）

# 阿里雲百煉 / DashScope API Key（中國北京區）
DASHSCOPE_API_KEY=

# 多模態 Embedding 模型（固定使用 qwen3-vl-embedding）
DASHSCOPE_EMBEDDING_MODEL=qwen3-vl-embedding

# qwen3-vl-embedding 僅支援北京區端點
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# 向量維度（須與 Qdrant collection 一致，預設 2560）
EMBEDDING_DIMENSION=2560

# 設為 1 時略過所有 Embedding 串接測試
# DASHSCOPE_SKIP=1
